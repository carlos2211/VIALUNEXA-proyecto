# Plantilla de nginx: la imagen oficial reemplaza ${PORT} al iniciar
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # Salud del contenedor (Render y Docker)
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Archivos con hash en el nombre: se pueden guardar en caché por un año
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # index.html nunca se guarda en caché: cada despliegue se ve de inmediato
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
